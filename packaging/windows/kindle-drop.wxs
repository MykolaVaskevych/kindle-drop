<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows installer for Kindle Drop (WiX Toolset v5).

  Built by packaging/windows/build-msi.ps1:
      wix build kindle-drop.wxs -arch x64 -d Version=... -d BinDir=... -d RepoDir=... -o kindle-drop.msi

  Per-machine install into Program Files, Start-menu shortcut, and the install
  folder added to the system PATH so the headless send mode works from a
  terminal. The UpgradeCode must never change: it is what lets a newer MSI
  replace an older one in place.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Kindle Drop"
           Manufacturer="Mykola Vaskevych"
           Version="$(var.Version)"
           UpgradeCode="9FE740DE-308E-4091-A87A-4726E022F35E"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Kindle Drop is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="kindle-drop.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/MykolaVaskevych/kindle-drop" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Kindle Drop">
        <Component Id="MainExe">
          <File Id="KindleDropExe" Source="$(var.BinDir)\kindle-drop.exe" KeyPath="yes" />
        </Component>
        <Component Id="Readme">
          <File Id="Readme" Source="$(var.RepoDir)\README.md" KeyPath="yes" />
        </Component>
        <Component Id="License">
          <File Id="License" Source="$(var.RepoDir)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
        </Component>
        <Component Id="PathEntry" Guid="58B7E7DC-B60F-4880-A4DA-6D272491A056">
          <CreateFolder />
          <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no"
                       Part="last" Action="set" System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="232133CE-A23E-4D9A-BF11-ADF8AE136E16">
        <Shortcut Id="AppShortcut" Name="Kindle Drop" Description="Send books to a jailbroken Kindle over USB"
                  Target="[INSTALLFOLDER]kindle-drop.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKLM" Key="Software\Kindle Drop" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="Readme" />
      <ComponentRef Id="License" />
      <ComponentRef Id="PathEntry" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
